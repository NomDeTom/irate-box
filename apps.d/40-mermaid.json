{
  "id": "mermaid",
  "order": 40,
  "tile": {
    "icon": "🧜",
    "name": "Mermaid",
    "desc": "Diagrams as text",
    "href": "/app.html#/mermaid/",
    "new_tab": true
  },
  "status": {
    "path": "/mermaid/",
    "name": "Mermaid",
    "root_env": "HUB_MERMAID_ROOT"
  },
  "install": {
    "dir": "apps/mermaid",
    "needs": "index.html",
    "title": "Mermaid editor"
  },
  "source": {
    "type": "bundle",
    "repo": "NomDeTom/mermaid-live-editor",
    "branch": "develop",
    "workflow": "irate-box-bundle.yml",
    "pattern": "irate-box-mermaid-*"
  },
  "core": true,
  "docs": [
    {
      "title": "Mermaid docs",
      "book": "mermaid-docs",
      "source": {
        "type": "nightly-link",
        "repo": "NomDeTom/mermaid",
        "workflow": "docs-zim.yml",
        "branch": "zim-build",
        "pattern": "mermaid-docs-*"
      },
      "lang": "en",
      "size_mb": 12
    }
  ],
  "entries": [
    {
      "menus": {
        "drawing": 40
      },
      "name": "Mermaid",
      "desc": "Diagrams as text",
      "href": "/app.html#/mermaid/"
    }
  ]
}
