# SPDX-License-Identifier: MIT
# SPDX-FileCopyrightText: 2026 NomDeTom
# Irate-Box front for nginx — one origin, path-routed. The default web server; the Caddyfile
# beside it is the same routes for Caddy, the fallback (install.sh --web caddy). A route
# changed here is changed there too.
#
# install.sh fills in the @...@ placeholders and writes the result to
# /etc/nginx/conf.d/irate-box.conf, which nginx includes inside its http {} block. Names at
# that level (the map variable, the upstream) carry an irate_box_ prefix so they cannot meet
# an owner's own config.
#
# Two listeners, as for Caddy:
#   - one plain-HTTP port, never a redirect to HTTPS, never HSTS. Captive-portal probes are
#     plain HTTP on :80.
#   - every service binds to 127.0.0.1; nginx is the sole listener on the AP interface.
#
# Against Caddy, measured on a Luckfox Lyra: ~40 MB less RAM and 5-10x less CPU per request.

# WebSocket upgrades pass through; a plain request sends no Connection header, so the
# keep-alive pool to the hub is reused.
# The box's own login (for scripts): from the box itself, its login file; from anywhere else, a second file that
# holds the login only when the admin chose that reach (/admin → Accounts; hub_control.py keeps it in step).
map $remote_addr $irate_box_logins {
	"127.0.0.1" "@HTPASSWD@";
	"::1" "@HTPASSWD@";
	default "@HTPASSWD@.net";
}

map $http_upgrade $irate_box_connection {
	default upgrade;
	''      "";
}

# The pages the web server serves itself (the apps' own files, no service of theirs to sample): a line for each
# page loaded (a folder or an .html, not the scripts and pictures it pulls in), with its time, status and path and
# nothing about who asked, for the hub's use heatmap (pagehistory.py). The rest of the box logs nothing.
map $uri $irate_box_page_load {
	~(/|\.html)$ 1;
	default 0;
}
log_format irate_box_pages '$msec $status $uri';

# HTTPS: each origin's port for the scheme a request came in on, so a
# redirect from a page on HTTPS goes to that origin's TLS twin. The twins listen only once the box
# has a certificate (root/tls.py writes the includes in each server block below); without one,
# nothing here changes what is served.
map $scheme $irate_box_hub_port   { https @TLS_PORT@;       default @PORT@; }
map $scheme $irate_box_addon_port { https @ADDON_TLS_PORT@; default @ADDON_PORT@; }
map $scheme $irate_box_notes_port { https @NOTES_TLS_PORT@; default @NOTES_PORT@; }
map $scheme $irate_box_wiki_port  { https @WIKI_TLS_PORT@;  default @WIKI_PORT@; }
map $scheme $irate_box_git_port   { https @GIT_TLS_PORT@;   default @GIT_PORT@; }
map $scheme $irate_box_notebook_port { https @NOTEBOOK_TLS_PORT@; default @NOTEBOOK_PORT@; }
map $scheme $irate_box_admin_port { https @ADMIN_TLS_PORT@; default @ADMIN_PORT@; }
map $scheme $irate_box_draw_port { https @DRAW_TLS_PORT@; default @DRAW_PORT@; }
map $scheme $irate_box_mermaid_port { https @MERMAID_TLS_PORT@; default @MERMAID_PORT@; }
map $scheme $irate_box_sync_port { https @SYNC_TLS_PORT@; default @SYNC_PORT@; }
# The hub's session cookie is the hub's: an app on a sibling port (notes, books, cgit, Syncthing)
# gets the rest of the Cookie header without it, so a page there cannot act as the owner.
# The gates (auth_request) still see the whole header.
map $http_cookie $irate_box_app_cookie {
	default $http_cookie;
	"~^(?<pre>.*?)irate_session=[^;]*;?\s*(?<post>.*)$" "$pre$post";
}

# The hub keeps HTTP/1.1 connections open. Reusing them matters: one new connection per
# request is what filled the hub's listen queue in the benchmark.
upstream irate_box_hub {
	server 127.0.0.1:8000;
	keepalive 8;
}

# The local add-ons' maps, per add-on id: off, login realm, Content-Security-Policy (the root
# helper writes them from /etc/hub/access.json and the add-ons' manifests). Read by the add-on
# server at the end of this file.
include @ADDON_ACCESS@;

server {
	include @TLS@/nginx-http-main.inc;
	include @TLS@/nginx-policy-main.inc;
	# Its TLS twin, once the box has a certificate (root/tls.py): listen ... ssl and the certificate.
	include @TLS@/nginx-main.conf*;
	server_name _;

	# Who may open each app (/admin: public, private or off), generated by the root helper
	# from /etc/hub/access.json: per app, $irate_box_auth_<id> ("off", or the login realm)
	# and $irate_box_off_<id> (non-empty when the app is switched off). Set here, at server
	# level, so every location below can read them.
	include @ACCESS@;
	# Users mode (access.py): the session check an app's gate asks
	# (@ACCESS@.d/gate-<id>.conf, only for an app in users mode), and where anyone without one goes.
	# Always a GET with no body (a POST's Content-Length without its body would leave the hub waiting
	# for one). Setting a header drops all the server's, so every one is set again
	# (as /admin/ does): Connection above all, or nginx asks the hub to close a connection it then
	# keeps for the next request (upstream keepalive), which fails.
	location = /_irate_user {
		internal;
		proxy_method GET;
		proxy_pass_request_body off;
		proxy_set_header Content-Length "";
		proxy_set_header Host $http_host;
		proxy_set_header X-Forwarded-For $remote_addr;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header X-Forwarded-Host $http_host;
		proxy_set_header X-Irate-Front "";
		proxy_set_header Connection "";
		proxy_pass http://irate_box_hub/_irate/user;
	}
	location = /_irate_admin {
		internal;
		proxy_method GET;
		proxy_pass_request_body off;
		proxy_set_header Content-Length "";
		proxy_set_header Host $http_host;
		proxy_set_header X-Forwarded-For $remote_addr;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header X-Forwarded-Host $http_host;
		proxy_set_header X-Irate-Front "";
		proxy_set_header Connection "";
		# Which page: the hub says yes for an unclaimed box only to /admin itself (never the shell).
		proxy_set_header X-Original-URI $request_uri;
		proxy_pass http://irate_box_hub/_irate/admin;
	}
	location @irate_box_login { return 302 /account.html?next=$uri; }

	# Caddy logged warnings only and compressed nothing on the fly; the same here. Request
	# bodies: 1 MB, nginx's own default, except where a route needs more and says so (the
	# drawing store and gallery 50 MB, the file drop 25 MB, git pushes 64 MB, notes 50 MB). nginx
	# buffers a body to the card before passing it on, so "unlimited" let one guest fill it.
	access_log off;
	gzip off;
	client_max_body_size 1m;
	# Redirects stay relative, so /draw -> /draw/ keeps whatever host and port the guest used.
	absolute_redirect off;

	# Every proxied location inherits these. A proxy_set_header inside a location would drop
	# the lot, so the ones that differ (/sync) repeat them in full.
	proxy_http_version 1.1;
	proxy_set_header Host $http_host;
	# The guest's own address only: $proxy_add_x_forwarded_for would keep whatever the
	# guest sent first, and the hub reads the first entry.
	proxy_set_header X-Forwarded-For $remote_addr;
	proxy_set_header X-Forwarded-Proto $scheme;
	proxy_set_header X-Forwarded-Host $http_host;
	proxy_set_header Upgrade $http_upgrade;
	proxy_set_header Connection $irate_box_connection;
	# Never a guest's: only the /admin location below sends it (the hub's proof of the login).
	proxy_set_header X-Irate-Front "";

	# --- hub: landing page, shoutbox, board, file store, captive-portal target ----
	# The Host header passes through untouched, so server.py's probe-host check
	# (captive.apple.com, connectivitycheck.gstatic.com, ...) still fires. / and /index.html
	# go to the hub, which fills in the tiles; other files under web/ come off disk.
	root @STATIC@;
	# A baseline Content-Security-Policy on every answer of this origin: no plugins,
	# no <base> hijack, framed by this origin alone. add_header is per location (a location with one
	# of its own loses the server's), so the line is repeated wherever Cache-Control is set.
	set $irate_box_csp "object-src 'none'; base-uri 'none'; frame-ancestors 'self'";
	add_header Content-Security-Policy $irate_box_csp always;
	location = / { proxy_pass http://irate_box_hub; }
	location = /index.html { proxy_pass http://irate_box_hub; }
	location / {
		try_files $uri @irate_box_hub;
		add_header Cache-Control "no-cache";
		add_header Content-Security-Policy $irate_box_csp always;
	}
	location @irate_box_hub { proxy_pass http://irate_box_hub; }
	# The drawing store and the gallery take whole drawings (store.py MAX_BODY, 50 MB).
	location ^~ /api/v2/ { client_max_body_size 50m; proxy_pass http://irate_box_hub; }
	location ^~ /api/saves { client_max_body_size 50m; proxy_pass http://irate_box_hub; }
	# The file drop's page and its files, behind the same switch as its upload.
	location = /drop.html {
		if ($irate_box_off_drop) { return 404; }
		auth_basic $irate_box_auth_drop;
		include @ACCESS@.d/gate-drop.conf*;
		auth_basic_user_file $irate_box_logins;
		add_header Cache-Control "no-cache";
		add_header Content-Security-Policy $irate_box_csp always;
	}
	# The themes page (its tile): public, private or off like the apps. Off hides only the
	# page; the 🎨 in every page's header stays.
	location = /themes.html {
		if ($irate_box_off_themes) { return 404; }
		auth_basic $irate_box_auth_themes;
		include @ACCESS@.d/gate-themes.conf*;
		auth_basic_user_file $irate_box_logins;
		add_header Cache-Control "no-cache";
		add_header Content-Security-Policy $irate_box_csp always;
	}
	location ^~ /api/drop/ {
		if ($irate_box_off_drop) { return 404; }
		auth_basic $irate_box_auth_drop;
		include @ACCESS@.d/gate-drop.conf*;
		auth_basic_user_file $irate_box_logins;
		proxy_pass http://irate_box_hub;
	}

	# --- the file drop: the per-file cap, before the body is read ------------------
	# nginx refuses a larger upload outright (413). Same limit as store.py's DROP_MAX_FILE.
	location = /api/drop {
		if ($irate_box_off_drop) { return 404; }
		auth_basic $irate_box_auth_drop;
		include @ACCESS@.d/gate-drop.conf*;
		auth_basic_user_file $irate_box_logins;
		client_max_body_size 25m;
		proxy_pass http://irate_box_hub;
	}

	# --- /wiki -> Kiwix, on an origin of its own (the server block at the end, port @WIKI_PORT@):
	# a book's pages run whatever script the book carries, from a download, a stick or a URL,
	# so on the hub's origin a book could act with the owner's login.
	location = /wiki { return 302 $scheme://$host:$irate_box_wiki_port/wiki/; }
	location /wiki/ {
		if ($irate_box_off_wiki) { return 404; }
		return 302 $scheme://$host:$irate_box_wiki_port$request_uri;
	}

	# --- /draw -> Excalidraw, and /mermaid -> mermaid-live-editor, each on an origin of its own ------
	# (the server blocks at the end, ports @DRAW_PORT@ and @MERMAID_PORT@). What they render is written by
	# others (a shared link, a drawing from the gallery), so on the hub's origin it could act with the
	# owner's login. Path and query are kept; the off switch stays here.
	location = /draw { return 302 $scheme://$host:$irate_box_draw_port/draw/; }
	location /draw/ {
		if ($irate_box_off_draw) { return 404; }
		return 302 $scheme://$host:$irate_box_draw_port$request_uri;
	}
	location = /mermaid { return 302 $scheme://$host:$irate_box_mermaid_port/mermaid/; }
	location /mermaid/ {
		if ($irate_box_off_mermaid) { return 404; }
		return 302 $scheme://$host:$irate_box_mermaid_port$request_uri;
	}

	# --- /tools -> the calculators, single-file pages --------------------------------
	location = /tools { return 301 /tools/; }
	location ^~ /tools/ {
		access_log @PAGELOG@ irate_box_pages if=$irate_box_page_load;
		if ($irate_box_off_tools) { return 404; }
		auth_basic $irate_box_auth_tools;
		include @ACCESS@.d/gate-tools.conf*;
		auth_basic_user_file $irate_box_logins;
		alias @APPS@/tools/;
		try_files $uri $uri/index.html =404;
		add_header Cache-Control "no-cache";
		add_header Content-Security-Policy $irate_box_csp always;
	}

	# --- /serial -> Meshtastic serial terminal / log analyser, static ----------------
	location = /serial { return 301 /serial/; }
	location ^~ /serial/ {
		access_log @PAGELOG@ irate_box_pages if=$irate_box_page_load;
		if ($irate_box_off_serial) { return 404; }
		auth_basic $irate_box_auth_serial;
		include @ACCESS@.d/gate-serial.conf*;
		auth_basic_user_file $irate_box_logins;
		alias @APPS@/serial/;
		add_header Cache-Control "no-cache";
		add_header Content-Security-Policy $irate_box_csp always;
		# The one-file build, for live USB from a file opened on the guest's own machine (Web
		# Serial needs a secure context, which this plain HTTP is not): saved, never opened here.
		location = /serial/serial-terminal.html {
			add_header Cache-Control "no-cache";
			add_header Content-Security-Policy $irate_box_csp always;
			add_header Content-Disposition 'attachment; filename="serial-terminal.html"';
		}
		location ^~ /serial/assets/ {
			add_header Cache-Control "public, max-age=31536000, immutable";
			add_header Content-Security-Policy $irate_box_csp always;
		}
	}

	# --- /addons/<id>/ -> the add-on origin (below): the local add-ons' own address ---------
	# Tiles and list pages link here, so a link stays on the hub's port and name.
	location ~ ^/addons/([a-z0-9-]+/.*)$ { return 302 $scheme://$host:$irate_box_addon_port/$1$is_args$args; }
	location = /addons { return 404; }

	# --- /notes -> SilverBullet (add-on), path passed through (SB_URL_PREFIX=/notes) --
	# On its socket (silverbullet.service). Its capability endpoints are refused here whatever
	# the unit says: the shell, the HTTP proxy, which can reach the hub's loopback API
	# past the /admin login, and the runtime API. Notes themselves stay open.
	# Notes live on an origin of their own (the server block at the end, port @NOTES_PORT@):
	# a note is written by anyone with notes access, and its pages run script, so on the hub's
	# origin a note could act with the owner's login.
	location = /notes { return 302 $scheme://$host:$irate_box_notes_port/notes/; }
	location ~* ^/notes/\.(shell|proxy|runtime) { return 403; }
	location /notes/ {
		if ($irate_box_off_notes) { return 404; }
		return 302 $scheme://$host:$irate_box_notes_port$request_uri;
	}
	# A notebook per login: on an origin of its own (the server block at the end), apart from the
	# shared notes', so a shared page's script cannot read anyone's own notebook.
	location ^~ /notebook/ {
		if ($irate_box_off_notes) { return 404; }
		return 302 $scheme://$host:$irate_box_notebook_port/notebook/;
	}

	# --- /sync -> Syncthing web GUI (add-on, operator only), on an origin of its own (the server block
	# at the end, port @SYNC_PORT@): it shows names that remote peers send.
	location = /sync { return 302 $scheme://$host:$irate_box_sync_port/sync/; }
	location /sync/ {
		if ($irate_box_off_sync) { return 404; }
		return 302 $scheme://$host:$irate_box_sync_port$request_uri;
	}

	# --- WebSockets: mosquitto (/mqtt), an add-on ------------------------------------
	# nginx closes a proxied connection after 60 s of silence by default; this stays up. (excalidraw-room's
	# /socket.io/ is on the drawing origin, with the page that opens it.)
	location = /mqtt {
		if ($irate_box_off_mqtt) { return 404; }
		auth_basic $irate_box_auth_mqtt;
		include @ACCESS@.d/gate-mqtt.conf*;
		auth_basic_user_file $irate_box_logins;
		proxy_read_timeout 1h;
		proxy_pass http://127.0.0.1:9001;
	}

	# --- /flasher -> the Meshtastic web flasher, as a download, and what it fetches -------
	# The page is a download opened from the guest's disk (flasher.py says why), so it fetches
	# everything below cross-origin: every answer is Access-Control-Allow-Origin: *, and a
	# preflight gets its answer here. The hub fills its own address into the page and answers
	# the small API; nginx serves the bundle's files and the librarian's firmware mirror.
	# Private puts the login on the page itself; what the downloaded page fetches cannot send
	# a login (it runs from the guest's disk), so it stays open unless the flasher is off.
	location = /flasher {
		if ($irate_box_off_flasher) { return 404; }
		auth_basic $irate_box_auth_flasher;
		include @ACCESS@.d/gate-flasher.conf*;
		auth_basic_user_file $irate_box_logins;
		proxy_pass http://irate_box_hub;
	}
	location = /flasher/ {
		access_log @PAGELOG@ irate_box_pages if=$irate_box_page_load;
		if ($irate_box_off_flasher) { return 404; }
		auth_basic $irate_box_auth_flasher;
		include @ACCESS@.d/gate-flasher.conf*;
		auth_basic_user_file $irate_box_logins;
		proxy_pass http://irate_box_hub;
	}
	location = /flasher/flasher.html {
		access_log @PAGELOG@ irate_box_pages if=$irate_box_page_load;
		if ($irate_box_off_flasher) { return 404; }
		auth_basic $irate_box_auth_flasher;
		include @ACCESS@.d/gate-flasher.conf*;
		auth_basic_user_file $irate_box_logins;
		proxy_pass http://irate_box_hub;
	}
	location /flasher/api/ {
		if ($irate_box_off_flasher) { return 404; }
		proxy_pass http://irate_box_hub;
	}
	# The bundle's licence notices (About links them) sit beside public/, not in it.
	location = /flasher/THIRD-PARTY-NOTICES.txt {
		if ($irate_box_off_flasher) { return 404; }
		alias @APPS@/flasher/THIRD-PARTY-NOTICES.txt;
		default_type text/plain;
		add_header Cache-Control "no-cache";
		add_header Content-Security-Policy $irate_box_csp always;
	}
	# The light web flasher's engine (ESP Web Tools), loaded by the page /flasher/ in place.
	location ^~ /flasher/esp-web-tools/ {
		if ($irate_box_off_flasher) { return 404; }
		alias @APPS@/esp-web-tools/;
		add_header Cache-Control "no-cache";
		add_header Content-Security-Policy $irate_box_csp always;
	}
	# FreeOCD's WebDebugger (an ARM flasher over WebUSB), in the flashing tools.
	location ^~ /flasher/freeocd/ {
		access_log @PAGELOG@ irate_box_pages if=$irate_box_page_load;
		if ($irate_box_off_flasher) { return 404; }
		alias @APPS@/freeocd/;
		add_header Cache-Control "no-cache";
		add_header Content-Security-Policy $irate_box_csp always;
	}
	location ^~ /flasher/firmware/ {
		if ($irate_box_off_flasher) { return 404; }
		alias @FIRMWARE@/;
		add_header Access-Control-Allow-Origin "*" always;
		add_header Cache-Control "no-cache";
		add_header Content-Security-Policy $irate_box_csp always;
		if ($request_method = OPTIONS) {
			add_header Access-Control-Allow-Origin "*";
			add_header Access-Control-Allow-Methods "GET, OPTIONS";
			add_header Access-Control-Allow-Headers "*";
			add_header Access-Control-Allow-Private-Network "true";
			add_header Access-Control-Max-Age 86400;
			return 204;
		}
	}
	location ^~ /flasher/ {
		if ($irate_box_off_flasher) { return 404; }
		alias @APPS@/flasher/public/;
		add_header Access-Control-Allow-Origin "*" always;
		add_header Cache-Control "no-cache";
		add_header Content-Security-Policy $irate_box_csp always;
		if ($request_method = OPTIONS) {
			add_header Access-Control-Allow-Origin "*";
			add_header Access-Control-Allow-Methods "GET, OPTIONS";
			add_header Access-Control-Allow-Headers "*";
			add_header Access-Control-Allow-Private-Network "true";
			add_header Access-Control-Max-Age 86400;
			return 204;
		}
	}

	# --- /git and /git-private -> git over HTTP, and cgit to browse ---------------------
	# Bare repositories under @GIT_ROOT@/public and /private, owned by the hub user, who runs
	# both CGIs: fcgiwrap on irate-box-git.socket. A clone, fetch or push (the smart-HTTP
	# paths below) goes to git http-backend; every other path is cgit's web view. Public:
	# anyone may browse and clone; who may push is each repository's preset (/admin's Git
	# page), which the hub answers for on every request (auth_request, gitrepos.decide).
	# Private: all of it behind the login. Pushes up to 64 MB.
	location = /git { return 301 /git/; }
	location = /git-private { return 301 /git-private/; }
	location ^~ /git-static/ { alias /usr/share/cgit/; add_header X-Content-Type-Options nosniff; }
	# Debian's highlight.js (libjs-highlight.js), for cgit's code view (web/cgit-hub.js): 850 KB,
	# so compressed and kept by the browser for a day.
	location ^~ /git-hl/ {
		alias /usr/share/javascript/highlight.js/;
		gzip on;
		gzip_types application/javascript text/javascript;
		add_header Cache-Control "public, max-age=86400";
		add_header Content-Security-Policy $irate_box_csp always;
		add_header X-Content-Type-Options nosniff;
	}
	# The hub says whether this request needs no login (a fetch, or a push to a repository
	# anyone may push to, while the git app is public), or whether its own credentials are an
	# account's that may; if not, the box's own login is the other way in
	# (satisfy any), which the hub never sees. Every header set again, as setting one drops the
	# server's (Connection above all: see /_irate_user).
	location = /_irate_git_access {
		internal;
		proxy_method GET;
		proxy_pass http://irate_box_hub/internal/git-access;
		proxy_pass_request_body off;
		proxy_set_header Content-Length "";
		proxy_set_header X-Original-URI $request_uri;
		proxy_set_header X-Original-Method $request_method;
		proxy_set_header Host $http_host;
		proxy_set_header X-Forwarded-For $remote_addr;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header X-Irate-Front "";
		proxy_set_header Connection "";
	}
	location ~ ^/git/(?<irate_box_git_path>[^/]+\.git/(HEAD|info/refs|objects/.+|git-upload-pack|git-receive-pack))$ {
		if ($irate_box_off_git) { return 404; }
		satisfy any;
		auth_request /_irate_git_access;
		auth_basic "Irate-Box";
		auth_basic_user_file $irate_box_logins;
		client_max_body_size 64m;
		include /etc/nginx/fastcgi_params;
		fastcgi_param SCRIPT_FILENAME /usr/lib/git-core/git-http-backend;
		fastcgi_param GIT_PROJECT_ROOT @GIT_ROOT@/public;
		fastcgi_param GIT_HTTP_EXPORT_ALL 1;
		fastcgi_param PATH_INFO /$irate_box_git_path;
		fastcgi_param REMOTE_USER $remote_user;
		fastcgi_read_timeout 1h;
		fastcgi_pass unix:/run/irate-box-git.sock;
	}
	# cgit's web view is on an origin of its own (the server block at the end, port @GIT_PORT@):
	# it shows what anyone who may push wrote. Clones and pushes stay here, so clone URLs keep
	# working, and the push presets above still decide.
	location ~ ^/git(/.*)$ {
		if ($irate_box_off_git) { return 404; }
		return 302 $scheme://$host:$irate_box_git_port$request_uri;
	}
	location ~ ^/git-private/(?<irate_box_git_path>[^/]+\.git/(HEAD|info/refs|objects/.+|git-upload-pack|git-receive-pack))$ {
		satisfy any;
		auth_request /_irate_git_access;
		auth_basic "Irate-Box";
		auth_basic_user_file $irate_box_logins;
		client_max_body_size 64m;
		include /etc/nginx/fastcgi_params;
		fastcgi_param SCRIPT_FILENAME /usr/lib/git-core/git-http-backend;
		fastcgi_param GIT_PROJECT_ROOT @GIT_ROOT@/private;
		fastcgi_param GIT_HTTP_EXPORT_ALL 1;
		fastcgi_param PATH_INFO /$irate_box_git_path;
		fastcgi_param REMOTE_USER $remote_user;
		fastcgi_read_timeout 1h;
		fastcgi_pass unix:/run/irate-box-git.sock;
	}
	location ~ ^/git-private(/.*)$ { return 302 $scheme://$host:$irate_box_git_port$request_uri; }

	# --- /admin -> the administration origin (the server block near the end, port @ADMIN_PORT@) --------
	# An origin is scheme, host and port, and a path isolates nothing: anything that runs script on the hub's
	# port (a shoutbox page, a dropped file, a drawing) could call /admin with an administrator's session.
	# So the administration pages are served only on a port of their own, and here /admin is a redirect to
	# it, path and query kept (a #fragment survives a redirect). This origin never sends the hub the
	# front's secret (server.py FRONT_SECRET), so the hub refuses an /admin request that arrives by it.
	location = /admin { return 302 $scheme://$host:$irate_box_admin_port/admin/; }
	location /admin/ { return 302 $scheme://$host:$irate_box_admin_port$request_uri; }

	# --- /term -> ttyd (the escape hatch), path passed through (--base-path /term) ----
	# Gated here only: ttyd has no credential, and listens on a socket only this web
	# server's group can open, so a stray unit start is not an open root shell.
	location = /term { return 301 /term/; }
	location /term/ {
		if ($irate_box_off_term) { return 404; }
		auth_basic "Irate-Box";
		auth_basic_user_file $irate_box_logins;
		include @ACCESS@.d/gate-admin.conf*;
		proxy_read_timeout 1h;
		proxy_pass http://unix:/run/ttyd/ttyd.sock;
	}

	# Nothing here sets Strict-Transport-Security. Keep it that way.
}

# --- the administration origin: /admin ---------------------------------------------------------
# Its own port, so nothing served on the hub's port (a shoutbox page, a dropped file, a drawing)
# can call /admin with an administrator's session: an origin is scheme, host and port, and the
# path isolates nothing. The hub's port redirects /admin here. Only this block sends the hub the
# front's secret (@FRONT@), and the hub refuses /admin without it; every other block clears the
# header. The session cookie is the hub's, set on its page: cookies are kept by host, not port, so
# it is sent here too and signing in is unchanged.
# What the page loads: its own files (scripts, styles, pictures: off disk), /admin/ (the hub),
# and the gallery's thumbnails. A page of the hub (a link in the administration pages to Git,
# Sync, the account page, help) is sent to the hub's origin, where it lives.
server {
	include @TLS@/nginx-http-admin.inc;
	include @TLS@/nginx-policy-admin.inc;
	# Its TLS twin, once the box has a certificate (root/tls.py): listen ... ssl and the certificate.
	include @TLS@/nginx-admin-site.conf*;
	server_name _;
	access_log off;
	gzip off;
	server_tokens off;
	client_max_body_size 1m;
	absolute_redirect off;
	include @ACCESS@;
	# The session check for an admin account (access.py gate-admin.conf asks it, beside the box's own
	# login). Every header set again, as setting one drops the server's (Connection above all: see the
	# hub block's /_irate_user).
	location = /_irate_admin {
		internal;
		proxy_method GET;
		proxy_pass_request_body off;
		proxy_set_header Content-Length "";
		proxy_set_header Host $http_host;
		proxy_set_header X-Forwarded-For $remote_addr;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header X-Forwarded-Host $http_host;
		proxy_set_header X-Irate-Front "";
		proxy_set_header Connection "";
		# Which page: the hub says yes for an unclaimed box only to /admin itself (never the shell).
		proxy_set_header X-Original-URI $request_uri;
		proxy_pass http://irate_box_hub/_irate/admin;
	}
	# Not signed in: the sign-in is the hub's page, which sends the browser back here.
	location @irate_box_login { return 302 $scheme://$host:$irate_box_hub_port/account.html?next=$uri; }
	# Where a page of the hub is: its own origin.
	location @irate_box_hub_origin { return 302 $scheme://$host:$irate_box_hub_port$request_uri; }
	proxy_http_version 1.1;
	proxy_set_header Host $http_host;
	proxy_set_header X-Forwarded-For $remote_addr;
	proxy_set_header X-Forwarded-Proto $scheme;
	proxy_set_header X-Forwarded-Host $http_host;
	proxy_set_header Upgrade $http_upgrade;
	proxy_set_header Connection $irate_box_connection;
	proxy_set_header X-Irate-Front "";
	root @STATIC@;
	set $irate_box_csp "object-src 'none'; base-uri 'none'; frame-ancestors 'self'";
	add_header Content-Security-Policy $irate_box_csp always;
	location = / { return 302 /admin/; }
	location = /admin { return 301 /admin/; }
	# Same login as /term and /sync. First use: while @UNCLAIMED@ exists no password has been chosen, and
	# /admin is let through with none, where the hub serves only the set-the-password page.
	# hub_control.py deletes the file when the password is set.
	location ^~ /admin/ {
		set $irate_box_admin_auth "Irate-Box";
		if (-f @UNCLAIMED@) { set $irate_box_admin_auth off; }
		auth_basic $irate_box_admin_auth;
		auth_basic_user_file $irate_box_logins;
		# Or an admin account's session: gate-admin.conf, from the root helper.
		include @ACCESS@.d/gate-admin.conf*;
		# The secret that tells the hub this came through here (server.py FRONT_SECRET), from a root-only
		# file. Setting a header here drops the server-level ones, so all again.
		include @FRONT@;
		proxy_set_header Host $http_host;
		proxy_set_header X-Forwarded-For $remote_addr;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header X-Forwarded-Host $http_host;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection $irate_box_connection;
		proxy_pass http://irate_box_hub;
	}
	# The gallery's thumbnails, which the Store pane fetches (opaque downloads: the page re-types them).
	location ~ ^/api/saves/[^/]+/thumb$ {
		limit_except GET { deny all; }
		auth_basic "Irate-Box";
		auth_basic_user_file $irate_box_logins;
		include @ACCESS@.d/gate-admin.conf*;
		proxy_pass http://irate_box_hub;
	}
	# Pages of the hub, wherever they are linked from (Git, Sync, the account and help pages): its origin.
	location ~* \.html$ { return 302 $scheme://$host:$irate_box_hub_port$request_uri; }
	# The page's own files; what the hub makes (the layout, the favicon, the header picture) and
	# everything else is the hub's.
	location / {
		try_files $uri @irate_box_hub_origin;
		add_header Cache-Control "no-cache";
		add_header Content-Security-Policy $irate_box_csp always;
	}
}


# --- the drawing origin: Excalidraw (/draw/) and its live-collaboration relay -------------------------
# Its own port, so what a drawing runs (others' drawings, a shared link) is on an origin with no /admin
# and none of the hub's pages. The same login switch as before (/admin, Apps), the same static build. It
# also holds what the app reaches on its own origin: the store behind "shareable link" and the gallery
# (the hub's /api/v2 and /api/saves, without the hub's session cookie) and the relay (/socket.io/).
server {
	include @TLS@/nginx-http-draw.inc;
	include @TLS@/nginx-policy-draw.inc;
	# Its TLS twin, once the box has a certificate (root/tls.py): listen ... ssl and the certificate.
	include @TLS@/nginx-draw.conf*;
	server_name _;
	access_log off;
	gzip off;
	server_tokens off;
	client_max_body_size 1m;
	absolute_redirect off;
	include @ACCESS@;
	# The session checks the app's gate asks (users mode, private): see the notes origin's.
	location = /_irate_user {
		internal;
		proxy_method GET;
		proxy_pass_request_body off;
		proxy_set_header Content-Length "";
		proxy_set_header Host $http_host;
		proxy_set_header X-Forwarded-For $remote_addr;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header X-Forwarded-Host $http_host;
		proxy_set_header X-Irate-Front "";
		proxy_set_header Connection "";
		proxy_pass http://irate_box_hub/_irate/user;
	}
	location = /_irate_admin {
		internal;
		proxy_method GET;
		proxy_pass_request_body off;
		proxy_set_header Content-Length "";
		proxy_set_header Host $http_host;
		proxy_set_header X-Forwarded-For $remote_addr;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header X-Forwarded-Host $http_host;
		proxy_set_header X-Irate-Front "";
		proxy_set_header Connection "";
		proxy_set_header X-Original-URI $request_uri;
		proxy_pass http://irate_box_hub/_irate/admin;
	}
	# Not signed in: the sign-in is the hub's page, which sends the browser back here.
	location @irate_box_login { return 302 $scheme://$host:$irate_box_hub_port/account.html?next=$uri; }
	proxy_http_version 1.1;
	proxy_set_header Host $http_host;
	proxy_set_header X-Forwarded-For $remote_addr;
	proxy_set_header X-Forwarded-Proto $scheme;
	proxy_set_header X-Forwarded-Host $http_host;
	proxy_set_header Upgrade $http_upgrade;
	proxy_set_header Connection $irate_box_connection;
	proxy_set_header X-Irate-Front "";
	root @STATIC@;
	# The hub's app bar frames the app (app.html), so the hub's origin may.
	set $irate_box_csp "object-src 'none'; base-uri 'none'; frame-ancestors 'self' $scheme://$host:$irate_box_hub_port $scheme://$host";
	add_header Content-Security-Policy $irate_box_csp always;
	# The hub, from the app's own link back to it.
	location = / { return 302 $scheme://$host:$irate_box_hub_port/; }
	location ~* \.html$ { return 302 $scheme://$host:$irate_box_hub_port$request_uri; }
	# The one script of the hub the app loads (the "Hub" link back).
	location = /hub-return.js {
		add_header Cache-Control "no-cache";
		add_header Content-Security-Policy $irate_box_csp always;
	}
	# Hashed build output is immutable; everything else must revalidate, or guests keep an
	# old build after an upgrade.
	location = /draw { return 301 /draw/; }
	location ^~ /draw/ {
		access_log @PAGELOG@ irate_box_pages if=$irate_box_page_load;
		if ($irate_box_off_draw) { return 404; }
		auth_basic $irate_box_auth_draw;
		include @ACCESS@.d/gate-draw.conf*;
		auth_basic_user_file $irate_box_logins;
		alias @APPS@/draw/;
		try_files $uri /draw/index.html;
		add_header Cache-Control "no-cache";
		add_header Content-Security-Policy $irate_box_csp always;
		location ^~ /draw/assets/ {
			try_files $uri /draw/index.html;
			add_header Cache-Control "public, max-age=31536000, immutable";
			add_header Content-Security-Policy $irate_box_csp always;
		}
	}
	# The drawing store and the gallery take whole drawings (store.py MAX_BODY, 50 MB). The hub's session
	# cookie is not sent on (the store keeps no accounts), so a drawing's script cannot use it.
	location ^~ /api/v2/ {
		client_max_body_size 50m;
		# Setting a header here drops the server's, so all again.
		proxy_set_header Host $http_host;
		proxy_set_header X-Forwarded-For $remote_addr;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header X-Forwarded-Host $http_host;
		proxy_set_header X-Irate-Front "";
		proxy_set_header Cookie $irate_box_app_cookie;
		proxy_pass http://irate_box_hub;
	}
	location ^~ /api/saves {
		client_max_body_size 50m;
		# Setting a header here drops the server's, so all again.
		proxy_set_header Host $http_host;
		proxy_set_header X-Forwarded-For $remote_addr;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header X-Forwarded-Host $http_host;
		proxy_set_header X-Irate-Front "";
		proxy_set_header Cookie $irate_box_app_cookie;
		proxy_pass http://irate_box_hub;
	}
	# excalidraw-room, live collaboration. nginx closes a proxied connection after 60 s of silence by default; this stays up.
	location /socket.io/ {
		proxy_read_timeout 1h;
		proxy_pass http://127.0.0.1:3002;
	}
	location / { return 404; }
}

# --- the diagram origin: mermaid-live-editor (/mermaid/) ----------------------------------------
# Its own port, so a diagram rendered from a link (script in the diagram's text) is on an origin with no
# /admin. Static files, the gallery's store for its History panel, and the link back to the hub.
server {
	include @TLS@/nginx-http-mermaid.inc;
	include @TLS@/nginx-policy-mermaid.inc;
	# Its TLS twin, once the box has a certificate (root/tls.py): listen ... ssl and the certificate.
	include @TLS@/nginx-mermaid.conf*;
	server_name _;
	access_log off;
	gzip off;
	server_tokens off;
	client_max_body_size 1m;
	absolute_redirect off;
	include @ACCESS@;
	location = /_irate_user {
		internal;
		proxy_method GET;
		proxy_pass_request_body off;
		proxy_set_header Content-Length "";
		proxy_set_header Host $http_host;
		proxy_set_header X-Forwarded-For $remote_addr;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header X-Forwarded-Host $http_host;
		proxy_set_header X-Irate-Front "";
		proxy_set_header Connection "";
		proxy_pass http://irate_box_hub/_irate/user;
	}
	location = /_irate_admin {
		internal;
		proxy_method GET;
		proxy_pass_request_body off;
		proxy_set_header Content-Length "";
		proxy_set_header Host $http_host;
		proxy_set_header X-Forwarded-For $remote_addr;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header X-Forwarded-Host $http_host;
		proxy_set_header X-Irate-Front "";
		proxy_set_header Connection "";
		proxy_set_header X-Original-URI $request_uri;
		proxy_pass http://irate_box_hub/_irate/admin;
	}
	location @irate_box_login { return 302 $scheme://$host:$irate_box_hub_port/account.html?next=$uri; }
	proxy_http_version 1.1;
	proxy_set_header Host $http_host;
	proxy_set_header X-Forwarded-For $remote_addr;
	proxy_set_header X-Forwarded-Proto $scheme;
	proxy_set_header X-Forwarded-Host $http_host;
	proxy_set_header X-Irate-Front "";
	root @STATIC@;
	set $irate_box_csp "object-src 'none'; base-uri 'none'; frame-ancestors 'self' $scheme://$host:$irate_box_hub_port $scheme://$host";
	add_header Content-Security-Policy $irate_box_csp always;
	location = / { return 302 $scheme://$host:$irate_box_hub_port/; }
	location ~* \.html$ { return 302 $scheme://$host:$irate_box_hub_port$request_uri; }
	location = /hub-return.js {
		add_header Cache-Control "no-cache";
		add_header Content-Security-Policy $irate_box_csp always;
	}
	location = /mermaid { return 301 /mermaid/; }
	location ^~ /mermaid/ {
		access_log @PAGELOG@ irate_box_pages if=$irate_box_page_load;
		if ($irate_box_off_mermaid) { return 404; }
		auth_basic $irate_box_auth_mermaid;
		include @ACCESS@.d/gate-mermaid.conf*;
		auth_basic_user_file $irate_box_logins;
		alias @APPS@/mermaid/;
		try_files $uri $uri.html /mermaid/index.html;
		add_header Cache-Control "no-cache";
		add_header Content-Security-Policy $irate_box_csp always;
		location ^~ /mermaid/_app/immutable/ {
			try_files $uri $uri.html /mermaid/index.html;
			add_header Cache-Control "public, max-age=31536000, immutable";
			add_header Content-Security-Policy $irate_box_csp always;
		}
	}
	location ^~ /api/v2/ {
		client_max_body_size 50m;
		# Setting a header here drops the server's, so all again.
		proxy_set_header Host $http_host;
		proxy_set_header X-Forwarded-For $remote_addr;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header X-Forwarded-Host $http_host;
		proxy_set_header X-Irate-Front "";
		proxy_set_header Cookie $irate_box_app_cookie;
		proxy_pass http://irate_box_hub;
	}
	location ^~ /api/saves {
		client_max_body_size 50m;
		# Setting a header here drops the server's, so all again.
		proxy_set_header Host $http_host;
		proxy_set_header X-Forwarded-For $remote_addr;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header X-Forwarded-Host $http_host;
		proxy_set_header X-Irate-Front "";
		proxy_set_header Cookie $irate_box_app_cookie;
		proxy_pass http://irate_box_hub;
	}
	location / { return 404; }
}

# --- the Syncthing origin: its web GUI (/sync/, operator only) ----------------------------------
# Its own port, so what remote peers name their devices and folders (shown in the GUI) is on an origin with
# no /admin. Prefix stripped. The GUI's own host check rejects anything but a loopback Host header. The hub's
# session cookie is not passed on. Gated as it was: the box's own login, or an admin account's session.
server {
	include @TLS@/nginx-http-sync.inc;
	include @TLS@/nginx-policy-sync.inc;
	# Its TLS twin, once the box has a certificate (root/tls.py): listen ... ssl and the certificate.
	include @TLS@/nginx-sync.conf*;
	server_name _;
	access_log off;
	gzip off;
	server_tokens off;
	absolute_redirect off;
	include @ACCESS@;
	location = /_irate_admin {
		internal;
		proxy_method GET;
		proxy_pass_request_body off;
		proxy_set_header Content-Length "";
		proxy_set_header Host $http_host;
		proxy_set_header X-Forwarded-For $remote_addr;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header X-Forwarded-Host $http_host;
		proxy_set_header X-Irate-Front "";
		proxy_set_header Connection "";
		proxy_set_header X-Original-URI $request_uri;
		proxy_pass http://irate_box_hub/_irate/admin;
	}
	location @irate_box_login { return 302 $scheme://$host:$irate_box_hub_port/account.html?next=$uri; }
	proxy_set_header X-Irate-Front "";
	location = / { return 302 /sync/; }
	location = /sync { return 301 /sync/; }
	location /sync/ {
		if ($irate_box_off_sync) { return 404; }
		auth_basic "Irate-Box";
		auth_basic_user_file $irate_box_logins;
		include @ACCESS@.d/gate-admin.conf*;
		proxy_http_version 1.1;
		proxy_set_header Host 127.0.0.1:8384;
		proxy_set_header Cookie $irate_box_app_cookie;
		proxy_set_header X-Forwarded-For $remote_addr;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header X-Forwarded-Host $http_host;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection $irate_box_connection;
		proxy_set_header X-Irate-Front "";
		proxy_pass http://127.0.0.1:8384/;
	}
	location / { return 404; }
}

# --- the add-on origin: the local add-ons ---------------------------------------------
# Their own origin, a second port, so nothing they serve can reach /admin with the owner's
# login, read the hub's storage, or script its pages. Their files are the hub user's
# (/var/lib/hub/addons/<id>/, from the librarian, no root); nothing here runs anything or
# proxies anywhere, and links are not followed (the hub owns the folder). Whether each is
# public, private or off, and what it may connect to, comes from the include at the top.
server {
	include @TLS@/nginx-http-addons.inc;
	include @TLS@/nginx-policy-addons.inc;
	# Its TLS twin, once the box has a certificate (root/tls.py): listen ... ssl and the certificate.
	include @TLS@/nginx-addons.conf*;
	server_name _;
	root @ADDONS@;
	disable_symlinks on;
	autoindex off;
	access_log off;
	server_tokens off;
	add_header X-Content-Type-Options nosniff always;
	add_header Referrer-Policy no-referrer always;
	add_header Cache-Control "no-cache" always;
	# Users mode for a local add-on (access.py): no per-id location exists ahead of
	# time (ids aren't known at template time, unlike the built-ins' own locations), so the
	# root helper writes one here per add-on in users mode (access.addon_gates), matched before
	# the shared location below; a public or off add-on never pays for the extra round trip.
	# Always a GET with no body, as /_irate_user elsewhere: see the comment at @ACCESS@ above.
	location = /_irate_user {
		internal;
		proxy_method GET;
		proxy_pass_request_body off;
		proxy_set_header Content-Length "";
		proxy_set_header Host $http_host;
		proxy_set_header X-Forwarded-For $remote_addr;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header X-Forwarded-Host $http_host;
		proxy_set_header X-Irate-Front "";
		proxy_set_header Connection "";
		proxy_pass http://irate_box_hub/_irate/user;
	}
	location @irate_box_login { return 302 $scheme://$host/account.html; }
	include @ADDON_GATES@/*.conf*;
	location ~ ^/(?<irate_box_addon>[a-z0-9-]+)/ {
		if ($irate_box_addon_off) { return 404; }
		auth_basic $irate_box_addon_auth;
		auth_basic_user_file $irate_box_logins;
		# Its own files only; never the bundle record or anything dotted.
		location ~ (^|/)(\.|irate-box-bundle\.json$) { return 404; }
		add_header Content-Security-Policy $irate_box_addon_csp always;
		add_header X-Content-Type-Options nosniff always;
		add_header Referrer-Policy no-referrer always;
		add_header Cache-Control "no-cache" always;
		try_files $uri $uri/index.html =404;
	}
	location / { return 404; }
}

# --- the notes origin: SilverBullet (--with-notes) -----------------------------------------
# Its own port, so what a note runs is on an origin with no /admin and none of the hub's
# storage. The same login switch as before (/admin, Apps: public, private or off), the same
# refusals, the same socket.
server {
	include @TLS@/nginx-http-notes.inc;
	include @TLS@/nginx-policy-notes.inc;
	# Its TLS twin, once the box has a certificate (root/tls.py): listen ... ssl and the certificate.
	include @TLS@/nginx-notes.conf*;
	server_name _;
	access_log off;
	gzip off;
	server_tokens off;
	absolute_redirect off;
	include @ACCESS@;
	# Users mode (access.py): the session check an app's gate asks
	# (@ACCESS@.d/gate-<id>.conf, only for an app in users mode), and where anyone without one goes.
	# Always a GET with no body (a POST's Content-Length without its body would leave the hub waiting
	# for one). Setting a header drops all the server's, so every one is set again
	# (as /admin/ does): Connection above all, or nginx asks the hub to close a connection it then
	# keeps for the next request (upstream keepalive), which fails.
	location = /_irate_user {
		internal;
		proxy_method GET;
		proxy_pass_request_body off;
		proxy_set_header Content-Length "";
		proxy_set_header Host $http_host;
		proxy_set_header X-Forwarded-For $remote_addr;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header X-Forwarded-Host $http_host;
		proxy_set_header X-Irate-Front "";
		proxy_set_header Connection "";
		proxy_pass http://irate_box_hub/_irate/user;
	}
	location = /_irate_admin {
		internal;
		proxy_method GET;
		proxy_pass_request_body off;
		proxy_set_header Content-Length "";
		proxy_set_header Host $http_host;
		proxy_set_header X-Forwarded-For $remote_addr;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header X-Forwarded-Host $http_host;
		proxy_set_header X-Irate-Front "";
		proxy_set_header Connection "";
		# Which page: the hub says yes for an unclaimed box only to /admin itself (never the shell).
		proxy_set_header X-Original-URI $request_uri;
		proxy_pass http://irate_box_hub/_irate/admin;
	}
	location @irate_box_login { return 302 $scheme://$host/account.html; }
	client_max_body_size 50m;  # attachments
	proxy_http_version 1.1;
	proxy_set_header Host $http_host;
	proxy_set_header X-Forwarded-For $remote_addr;
	proxy_set_header X-Forwarded-Proto $scheme;
	proxy_set_header Upgrade $http_upgrade;
	proxy_set_header Connection $irate_box_connection;
	proxy_set_header X-Irate-Front "";
	location = / { return 302 /notes/; }
	location = /notes { return 301 /notes/; }
	location ~* ^/notes/\.(shell|proxy|runtime) { return 403; }
	location /notes/ {
		if ($irate_box_off_notes) { return 404; }
		auth_basic $irate_box_auth_notes;
		include @ACCESS@.d/gate-notes.conf*;
		auth_basic_user_file $irate_box_logins;
		proxy_set_header Cookie $irate_box_app_cookie;
		proxy_read_timeout 1h;
		proxy_pass http://unix:/run/silverbullet/silverbullet.sock;
	}
	location / { return 404; }
}

# --- the notebooks' origin: a SilverBullet per login (--with-notes) -----------------------------
# The hub answers every request (/_irate/notebook): whose notebook this session's is, as a header
# routed on to that login's socket; not signed in, to the sign-in; not running yet, to the hub's
# waiting page, which starts it.
server {
	include @TLS@/nginx-http-notebook.inc;
	include @TLS@/nginx-policy-notebook.inc;
	include @TLS@/nginx-notebook.conf*;
	server_name _;
	access_log off;
	gzip off;
	server_tokens off;
	absolute_redirect off;
	include @ACCESS@;
	# Every header set again, as setting one drops the server's (Connection above all: see the notes' /_irate_user).
	location = /_irate_notebook {
		internal;
		proxy_method GET;
		proxy_pass_request_body off;
		proxy_set_header Content-Length "";
		proxy_set_header Host $http_host;
		proxy_set_header X-Forwarded-For $remote_addr;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header X-Forwarded-Host $http_host;
		proxy_set_header X-Irate-Front "";
		proxy_set_header Connection "";
		proxy_pass http://irate_box_hub/_irate/notebook;
	}
	location @irate_box_login { return 302 $scheme://$host:$irate_box_hub_port/account.html?next=/notebook.html; }
	location @irate_box_notebook_wait { return 302 $scheme://$host:$irate_box_hub_port/notebook.html; }
	client_max_body_size 50m;  # attachments
	proxy_http_version 1.1;
	proxy_set_header Host $http_host;
	proxy_set_header X-Forwarded-For $remote_addr;
	proxy_set_header X-Forwarded-Proto $scheme;
	proxy_set_header Upgrade $http_upgrade;
	proxy_set_header Connection $irate_box_connection;
	proxy_set_header X-Irate-Front "";
	location = / { return 302 /notebook/; }
	location = /notebook { return 301 /notebook/; }
	location ~* ^/notebook/\.(shell|proxy|runtime) { return 403; }
	location /notebook/ {
		if ($irate_box_off_notes) { return 404; }
		auth_request /_irate_notebook;
		auth_request_set $irate_box_notebook $upstream_http_x_irate_notebook;
		error_page 401 = @irate_box_login;
		error_page 403 = @irate_box_notebook_wait;
		proxy_set_header Cookie $irate_box_app_cookie;
		proxy_read_timeout 1h;
		proxy_pass http://unix:/run/irate-box-notebooks/$irate_box_notebook/sb.sock:;
	}
	location / { return 404; }
}

# --- the books' origin: Kiwix ---------------------------------------------------------------
# kiwix-serve on 127.0.0.1:8081, path passed through (--urlRootLocation /wiki), with the same
# login switch as before (/admin, Apps).
server {
	include @TLS@/nginx-http-wiki.inc;
	include @TLS@/nginx-policy-wiki.inc;
	# Its TLS twin, once the box has a certificate (root/tls.py): listen ... ssl and the certificate.
	include @TLS@/nginx-wiki.conf*;
	server_name _;
	access_log off;
	gzip off;
	server_tokens off;
	absolute_redirect off;
	include @ACCESS@;
	# Users mode (access.py): the session check an app's gate asks
	# (@ACCESS@.d/gate-<id>.conf, only for an app in users mode), and where anyone without one goes.
	# Always a GET with no body (a POST's Content-Length without its body would leave the hub waiting
	# for one). Setting a header drops all the server's, so every one is set again
	# (as /admin/ does): Connection above all, or nginx asks the hub to close a connection it then
	# keeps for the next request (upstream keepalive), which fails.
	location = /_irate_user {
		internal;
		proxy_method GET;
		proxy_pass_request_body off;
		proxy_set_header Content-Length "";
		proxy_set_header Host $http_host;
		proxy_set_header X-Forwarded-For $remote_addr;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header X-Forwarded-Host $http_host;
		proxy_set_header X-Irate-Front "";
		proxy_set_header Connection "";
		proxy_pass http://irate_box_hub/_irate/user;
	}
	location = /_irate_admin {
		internal;
		proxy_method GET;
		proxy_pass_request_body off;
		proxy_set_header Content-Length "";
		proxy_set_header Host $http_host;
		proxy_set_header X-Forwarded-For $remote_addr;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header X-Forwarded-Host $http_host;
		proxy_set_header X-Irate-Front "";
		proxy_set_header Connection "";
		# Which page: the hub says yes for an unclaimed box only to /admin itself (never the shell).
		proxy_set_header X-Original-URI $request_uri;
		proxy_pass http://irate_box_hub/_irate/admin;
	}
	location @irate_box_login { return 302 $scheme://$host/account.html; }
	proxy_http_version 1.1;
	proxy_set_header Host $http_host;
	proxy_set_header X-Forwarded-For $remote_addr;
	proxy_set_header X-Irate-Front "";
	location = / { return 302 /wiki/; }
	location = /wiki { return 301 /wiki/; }
	location /wiki/ {
		if ($irate_box_off_wiki) { return 404; }
		auth_basic $irate_box_auth_wiki;
		include @ACCESS@.d/gate-wiki.conf*;
		auth_basic_user_file $irate_box_logins;
		proxy_set_header Cookie $irate_box_app_cookie;
		proxy_pass http://127.0.0.1:8081;
	}
	# kiwix-serve sends book pages max-age=3600, so a rebuilt ZIM would hide behind the old
	# copy for an hour. Its ETag carries the book UUID, so always revalidating is a cheap 304.
	location /wiki/content/ {
		if ($irate_box_off_wiki) { return 404; }
		auth_basic $irate_box_auth_wiki;
		include @ACCESS@.d/gate-wiki.conf*;
		auth_basic_user_file $irate_box_logins;
		proxy_hide_header Cache-Control;
		add_header Cache-Control "no-cache" always;
		proxy_set_header Cookie $irate_box_app_cookie;
		proxy_pass http://127.0.0.1:8081;
	}
	location / { return 404; }
}

# --- cgit's origin: the git servers' web view -----------------------------------------------
# What a repository holds is written by whoever may push, so its pages are served away from
# /admin. Its CSP (scripts only the box's own) lets the hub's app bar frame it. Clones and
# pushes are the hub's port's (a smart-HTTP request here is sent there).
server {
	include @TLS@/nginx-http-git.inc;
	include @TLS@/nginx-policy-git.inc;
	# Its TLS twin, once the box has a certificate (root/tls.py): listen ... ssl and the certificate.
	include @TLS@/nginx-git.conf*;
	server_name _;
	access_log off;
	gzip off;
	server_tokens off;
	absolute_redirect off;
	include @ACCESS@;
	# Users mode (access.py): the session check an app's gate asks
	# (@ACCESS@.d/gate-<id>.conf, only for an app in users mode), and where anyone without one goes.
	# Always a GET with no body (a POST's Content-Length without its body would leave the hub waiting
	# for one). Setting a header drops all the server's, so every one is set again
	# (as /admin/ does): Connection above all, or nginx asks the hub to close a connection it then
	# keeps for the next request (upstream keepalive), which fails.
	location = /_irate_user {
		internal;
		proxy_method GET;
		proxy_pass_request_body off;
		proxy_set_header Content-Length "";
		proxy_set_header Host $http_host;
		proxy_set_header X-Forwarded-For $remote_addr;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header X-Forwarded-Host $http_host;
		proxy_set_header X-Irate-Front "";
		proxy_set_header Connection "";
		proxy_pass http://irate_box_hub/_irate/user;
	}
	location = /_irate_admin {
		internal;
		proxy_method GET;
		proxy_pass_request_body off;
		proxy_set_header Content-Length "";
		proxy_set_header Host $http_host;
		proxy_set_header X-Forwarded-For $remote_addr;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header X-Forwarded-Host $http_host;
		proxy_set_header X-Irate-Front "";
		proxy_set_header Connection "";
		# Which page: the hub says yes for an unclaimed box only to /admin itself (never the shell).
		proxy_set_header X-Original-URI $request_uri;
		proxy_pass http://irate_box_hub/_irate/admin;
	}
	location @irate_box_login { return 302 $scheme://$host/account.html; }
	root @STATIC@;
	location = / { return 302 /git/; }
	location = /git { return 301 /git/; }
	location = /git-private { return 301 /git-private/; }
	# What cgit's pages load (config/cgit-head.html): the palette, the hub's cgit look, the
	# theme and highlighting scripts, cgit's own files and Debian's highlight.js.
	location = /palette.css { add_header X-Content-Type-Options nosniff; }
	location = /cgit-hub.css { add_header X-Content-Type-Options nosniff; }
	location = /themes.js { add_header X-Content-Type-Options nosniff; }
	location = /cgit-hub.js { add_header X-Content-Type-Options nosniff; }
	location ^~ /themes/ { add_header X-Content-Type-Options nosniff; }
	location ^~ /git-static/ { alias /usr/share/cgit/; add_header X-Content-Type-Options nosniff; }
	location ^~ /git-hl/ {
		alias /usr/share/javascript/highlight.js/;
		gzip on;
		gzip_types application/javascript text/javascript;
		add_header Cache-Control "public, max-age=86400";
		add_header X-Content-Type-Options nosniff;
	}
	location ~ ^/git(-private)?/[^/]+\.git/(HEAD|info/refs|objects/.+|git-upload-pack|git-receive-pack)$ {
		return 302 $scheme://$host:$irate_box_hub_port$request_uri;
	}
	location ~ ^/git(?<irate_box_cgit_path>/.*)$ {
		if ($irate_box_off_git) { return 404; }
		auth_basic $irate_box_auth_git;
		include @ACCESS@.d/gate-git.conf*;
		auth_basic_user_file $irate_box_logins;
		include /etc/nginx/fastcgi_params;
		fastcgi_param SCRIPT_FILENAME /usr/lib/cgit/cgit.cgi;
		fastcgi_param CGIT_CONFIG @GIT_ROOT@/cgitrc-public;
		# Scripts: only the box's own (themes.js, cgit.js); a README's HTML is already text
		# (scripts/cgit-about.py), this is the second lock. nosniff: a repository's files,
		# served as text/plain, are never run as a script.
		add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'self' $scheme://$host:$irate_box_hub_port $scheme://$host" always;
		add_header X-Content-Type-Options nosniff always;
		fastcgi_param HTTP_HOST $host:@PORT@;  # cgit's clone URLs: the hub's port, where git is served
		fastcgi_param PATH_INFO $irate_box_cgit_path;
		fastcgi_param HTTP_COOKIE $irate_box_app_cookie;
		fastcgi_pass unix:/run/irate-box-git.sock;
	}
	location ~ ^/git-private(?<irate_box_cgit_path>/.*)$ {
		auth_basic "Irate-Box";
		auth_basic_user_file $irate_box_logins;
		include @ACCESS@.d/gate-admin.conf*;
		include /etc/nginx/fastcgi_params;
		fastcgi_param SCRIPT_FILENAME /usr/lib/cgit/cgit.cgi;
		fastcgi_param CGIT_CONFIG @GIT_ROOT@/cgitrc-private;
		# Scripts: only the box's own (themes.js, cgit.js); a README's HTML is already text
		# (scripts/cgit-about.py), this is the second lock. nosniff: a repository's files,
		# served as text/plain, are never run as a script.
		add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'self' $scheme://$host:$irate_box_hub_port $scheme://$host" always;
		add_header X-Content-Type-Options nosniff always;
		fastcgi_param HTTP_HOST $host:@PORT@;  # cgit's clone URLs: the hub's port, where git is served
		fastcgi_param PATH_INFO $irate_box_cgit_path;
		fastcgi_param HTTP_COOKIE $irate_box_app_cookie;
		fastcgi_pass unix:/run/irate-box-git.sock;
	}
	location / { return 404; }
}
