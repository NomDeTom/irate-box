# Irate-Box front for Caddy — one origin, path-routed.
#
# Caddy is the fallback (install.sh --web caddy); nginx, with the same routes in
# irate-box.nginx, is the default. A route changed here is changed there too.
#
# Two listeners:
#   - :80 always plain. Captive-portal probes are HTTP; an HTTPS listener appears only
#     when the box has a certificate (root/tls.py writes its
#     sites, imported at the end), and never as a redirect target.
#   - The routes are snippets, (irate_box_hub) and (irate_box_addons), so the plain
#     sites and their HTTPS twins serve the same: Caddy can't put TLS on one port of a
#     site block whose other port is plain.
#   - never a blanket HTTP→HTTPS redirect, never HSTS. auto_https off keeps Caddy
#     from adding either on its own.
#
# Every service binds to 127.0.0.1; Caddy is the sole listener on the AP interface.
# Guests see http://192.168.4.1/… and nothing else — no ports, no pi.local.
#
# Run in dev:   caddy run --config Caddyfile        (needs :80, so sudo or setcap)
#               PORT=8000 python3 server.py
# Paths are {$ENV:default} placeholders — HUB_STATIC, HUB_MERMAID_ROOT, HUB_DRAW_ROOT —
# so a different checkout layout is an environment variable, not an edit. See BUILDING.md.
{
	auto_https off
	admin off
}

(irate_box_hub) {
	# Never a guest's: only the /admin route below sends it (the hub's proof of the login).
	request_header -X-Irate-Front
	# A baseline Content-Security-Policy on every answer of this origin.
	header Content-Security-Policy "object-src 'none'; base-uri 'none'; frame-ancestors 'self'"

	# --- hub: landing page, shoutbox, board, file store, captive-portal target ----
	# Host header passes through untouched, so server.py's probe-host check
	# (captive.apple.com, connectivitycheck.gstatic.com, …) still fires here.
	# On the Pi the unit sets HUB_URL=http://192.168.4.1/ (portless) and binds to loopback.
	# Assets (js, css, board.html…) come straight off disk. `/` itself stays with
	# the hub so the captive-probe check runs before index.html is served.
	handle {
		root * {$HUB_STATIC:/home/user/irate-box/web}
		# / and /index.html go to the hub, which fills in the tiles from apps.d/.
		@asset {
			file
			not path / /index.html
		}
		route {
			header @asset Cache-Control "no-cache"
			file_server @asset
			reverse_proxy 127.0.0.1:8000
		}
	}

	# --- the file drop: the per-file cap, before the body is read ------------------
	# Caddy refuses a larger upload outright (413), so a guest cannot stream gigabytes at
	# the hub only for it to be thrown away. store.py checks the same limit (DROP_MAX_FILE).
	handle /api/drop {
		import {$HUB_ACCESS_DIR:/etc/caddy/irate-box-access}/drop.caddy*
		request_body {
			max_size 25MB
		}
		reverse_proxy 127.0.0.1:8000
	}

	# The themes page (its tile): public, private or off like the apps. Off hides only the
	# page; the 🎨 in every page's header stays.
	handle /themes.html {
		import {$HUB_ACCESS_DIR:/etc/caddy/irate-box-access}/themes.caddy*
		root * {$HUB_STATIC:/home/user/irate-box/web}
		header Cache-Control "no-cache"
		file_server
	}

	# The file drop's page and its files, behind the same switch as its upload.
	handle /drop.html {
		import {$HUB_ACCESS_DIR:/etc/caddy/irate-box-access}/drop.caddy*
		root * {$HUB_STATIC:/home/user/irate-box/web}
		header Cache-Control "no-cache"
		file_server
	}
	handle /api/drop/* {
		import {$HUB_ACCESS_DIR:/etc/caddy/irate-box-access}/drop.caddy*
		reverse_proxy 127.0.0.1:8000
	}

	# --- /wiki → kiwix-serve ------------------------------------------------------
	# Path is passed through, not stripped: run kiwix-serve with
	#   --urlRootLocation /wiki  --blockexternal  -p 8081  -i 127.0.0.1
	# so its own links come out under /wiki/ too.
	handle /wiki/* {
		import {$HUB_ACCESS_DIR:/etc/caddy/irate-box-access}/wiki.caddy*
		# kiwix-serve sends book pages max-age=3600, so a rebuilt ZIM stays hidden behind
		# the old copy for an hour. Its ETag carries the book UUID, which a rebuild
		# changes, so always revalidating is cheap (a 304) and never stale.
		# (header_down takes no matcher; a deferred header runs after the proxy's own.)
		@content path /wiki/content/*
		header @content Cache-Control "no-cache" {
			defer
		}
		reverse_proxy 127.0.0.1:8081
	}
	redir /wiki /wiki/ permanent

	# Who may open each app (/admin: public, private or off): the root helper writes one
	# snippet per app into $HUB_ACCESS_DIR from /etc/hub/access.json, imported at the top of
	# the app's route: nothing, the admin login, or a 404 (<id>-off: only the 404, for the
	# routes that always ask for the login or must stay open). As a glob (the trailing *), an
	# import that matches nothing is no error, so a dev checkout with no such folder runs as it is.
	# --- /draw → Excalidraw, static ------------------------------------------------
	# The fork built with `vite build --mode hub --base /draw/` (.env.hub in the fork):
	# storage is the hub's own /api/v2 on this origin, so no NestJS, no Redis, no
	# container. Packaged as hub-app-excalidraw it moves to /usr/share/hub/apps/excalidraw.
	handle_path /draw/* {
		import {$HUB_ACCESS_DIR:/etc/caddy/irate-box-access}/draw.caddy*
		root * {$HUB_DRAW_ROOT:/home/user/excalidraw-stack/excalidraw/excalidraw-app/build}
		@immutable path /assets/*
		@mutable not path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		header @mutable Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
	redir /draw /draw/ permanent

	# --- /mermaid → mermaid-live-editor, static ------------------------------------
	# SvelteKit adapter-static build in
	# ~/mermaid-live-editor/docs, asset links relative so no MERMAID_BASE_PATH rebuild
	# is needed. Packaged as hub-app-mermaid it moves to /usr/share/hub/apps/mermaid.
	handle_path /mermaid/* {
		import {$HUB_ACCESS_DIR:/etc/caddy/irate-box-access}/mermaid.caddy*
		root * {$HUB_MERMAID_ROOT:/home/user/mermaid-live-editor/docs}
		# Hashed build output is immutable; everything else (html, manifest, the
		# service worker) must revalidate, or guests keep an old build after an upgrade.
		@immutable path /_app/immutable/*
		@mutable not path /_app/immutable/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		header @mutable Cache-Control "no-cache"
		try_files {path} {path}.html /index.html
		file_server
	}
	redir /mermaid /mermaid/ permanent

	# --- /tools → nomdetom.github.io, the calculators --------------------------------
	# Single-file HTML tools (LoRa airtime, Meshtastic node ID / URL / packet layout,
	# solar, battery, Ohm's law…). Self-contained, relative links, nothing fetched.
	handle_path /tools/* {
		import {$HUB_ACCESS_DIR:/etc/caddy/irate-box-access}/tools.caddy*
		root * {$HUB_TOOLS_ROOT:/home/user/nomdetom.github.io}
		header Cache-Control "no-cache"
		file_server
	}
	redir /tools /tools/ permanent

	# --- /serial → Meshtastic serial terminal / log analyser, static -----------------
	# `npm run build` of nomdetom/serial-terminal (base './', so no path rebuild).
	# Log files open fine over plain HTTP; the live serial connection needs a secure
	# context, which this origin is not -- the single-file download fixes that.
	handle_path /serial/* {
		import {$HUB_ACCESS_DIR:/etc/caddy/irate-box-access}/serial.caddy*
		root * {$HUB_SERIAL_ROOT:/home/user/serial-terminal/dist}
		# The one-file build, for live USB from a file opened on the guest's own machine (Web
		# Serial needs a secure context, which file:// is and this plain HTTP is not): saved,
		# never opened here.
		@download path /serial-terminal.html
		header @download Content-Disposition "attachment; filename=\"serial-terminal.html\""
		@immutable path /assets/*
		@mutable not path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		header @mutable Cache-Control "no-cache"
		file_server
	}
	redir /serial /serial/ permanent

	# --- /addons/<id>/ → the add-on origin (below): the local add-ons' own address ----------
	# Tiles and list pages link here, so a link stays on the hub's port and name.
	@addon path_regexp addon ^/addons/([a-z0-9-]+/.*)$
	redir @addon http://{host}:{$HUB_ADDON_PORT:8090}/{re.addon.1}{uri.query_string_with_question_mark} 302

	# --- /notes → SilverBullet (optional add-on) ------------------------------------
	# Markdown notes in a plain folder. Not in any profile: 502 and a greyed card until
	# installed. Official builds are ARMv7/ARM64 only, so never on the Zero W.
	# Path passes through (SB_URL_PREFIX=/notes), to its socket (silverbullet.service). Its
	# capability endpoints are refused whatever the unit says: the shell, the HTTP proxy,
	# which can reach the hub's loopback API past the /admin login, and the runtime API.
	handle /notes/* {
		import {$HUB_ACCESS_DIR:/etc/caddy/irate-box-access}/notes.caddy*
		@capability path_regexp (?i)^/notes/\.(shell|proxy|runtime)
		respond @capability 403
		reverse_proxy unix//run/silverbullet/silverbullet.sock {
			header_up Cookie "irate_session=[^;]*;?\s*" ""
		}
	}
	redir /notes /notes/ permanent

	# --- /sync → Syncthing web GUI (optional add-on, operator only) -------------------
	# Same gate as /admin. The GUI's own host check rejects anything but a loopback
	# Host header, hence header_up. The sync protocol (:22000) and local discovery
	# (:21027/udp) do not go through Caddy; the sole-listener rule has this one exception.
	handle_path /sync/* {
		import {$HUB_ACCESS_DIR:/etc/caddy/irate-box-access}/sync-off.caddy*
		# The login, or an admin account's session (access.py caddy_admin_gate): the hub's answer,
		# copied onto the request, skips the login. A guest's own X-Irate-Session never counts.
		route {
			request_header -X-Irate-Session
			import {$HUB_ACCESS_DIR:/etc/caddy/irate-box-access}/admin-gate.caddy*
			@irate_box_basic not header X-Irate-Session admin
			basic_auth @irate_box_basic {
				admin $2a$14$REPLACE_ME_WITH_CADDY_HASH_PASSWORD_OUTPUT
			}
			request_header -X-Irate-Session
		}
		reverse_proxy 127.0.0.1:8384 {
			header_up Host {upstream_hostport}
			header_up Cookie "irate_session=[^;]*;?\s*" ""
		}
	}
	redir /sync /sync/ permanent

	# --- /mqtt → mosquitto's WebSocket listener (optional add-on) --------------------
	# For pages on this origin. Nodes use the native listener on :1883 directly, since
	# raw MQTT is not HTTP. reverse_proxy carries the WebSocket upgrade as it is.
	handle /mqtt {
		import {$HUB_ACCESS_DIR:/etc/caddy/irate-box-access}/mqtt.caddy*
		reverse_proxy 127.0.0.1:9001
	}

	# --- /socket.io → excalidraw-room, live collaboration for /draw/ (optional add-on)
	# The hub build of Excalidraw connects to its own origin and probes this path at load:
	# no room installed means the proxy fails, and the app simply hides collaboration.
	handle /socket.io/* {
		reverse_proxy 127.0.0.1:3002
	}

	# --- /flasher → the Meshtastic web flasher, as a download, and what it fetches -------
	# The page is a download opened from the guest's disk (flasher.py says why), so it fetches
	# everything below cross-origin: every answer is Access-Control-Allow-Origin: *, and a
	# preflight gets its answer here. The hub fills its own address into the page and answers
	# the small API; Caddy serves the bundle's files and the librarian's firmware mirror.
	# Inside handle /flasher* (sorted ahead of the hub's catch-all handle), a route, so these
	# run in the order written: Caddy would otherwise sort the handle_path blocks ahead of the
	# hub's, and the page and the API would get the static files' 404.
	handle /flasher* {
		route {
			# Off: everything here answers 404. Private: the login on the page itself; what the
			# downloaded page fetches cannot send one (it runs from the guest's disk).
			import {$HUB_ACCESS_DIR:/etc/caddy/irate-box-access}/flasher-off.caddy*
			@flasher_page path /flasher /flasher/ /flasher/flasher.html
			handle @flasher_page {
				import {$HUB_ACCESS_DIR:/etc/caddy/irate-box-access}/flasher.caddy*
				reverse_proxy 127.0.0.1:8000
			}
			@flasher_hub path /flasher/api/*
			reverse_proxy @flasher_hub 127.0.0.1:8000
			# The bundle's licence notices (About links them) sit beside public/, not in it.
			handle /flasher/THIRD-PARTY-NOTICES.txt {
				root * {$HUB_FLASHER_ROOT:/usr/share/hub/apps/flasher}
				rewrite * /THIRD-PARTY-NOTICES.txt
				header Cache-Control "no-cache"
				file_server
			}
			handle_path /flasher/firmware/* {
				header Access-Control-Allow-Origin "*"
				header Cache-Control "no-cache"
				@preflight method OPTIONS
				handle @preflight {
					header Access-Control-Allow-Methods "GET, OPTIONS"
					header Access-Control-Allow-Headers "*"
					header Access-Control-Allow-Private-Network "true"
					header Access-Control-Max-Age 86400
					respond 204
				}
				root * {$HUB_FIRMWARE_ROOT:/var/lib/hub/firmware}
				file_server
			}
			handle_path /flasher/* {
				header Access-Control-Allow-Origin "*"
				header Cache-Control "no-cache"
				@preflight method OPTIONS
				handle @preflight {
					header Access-Control-Allow-Methods "GET, OPTIONS"
					header Access-Control-Allow-Headers "*"
					header Access-Control-Allow-Private-Network "true"
					header Access-Control-Max-Age 86400
					respond 204
				}
				root * {$HUB_FLASHER_ROOT:/usr/share/hub/apps/flasher}/public
				file_server
			}
		}
	}

	# --- /git and /git-private → git over HTTP, and cgit to browse ---------------------
	# Bare repositories under $HUB_GIT_ROOT/public and /private, owned by the hub user, who
	# runs both CGIs: fcgiwrap on irate-box-git.socket. A clone, fetch or push (the smart-HTTP
	# paths in @smart) goes to git http-backend; every other path is cgit's web view. As on
	# nginx, the hub decides each clone, fetch and push (gitrepos.decide: the repository's
	# preset, the git app's switch, an account's own credentials), asked with forward_auth: its
	# "ok" skips the box's own login, which is the way in otherwise, and its X-Irate-User is the
	# account's name for the push hook (REMOTE_USER; nginx's $remote_user). Private: the admin's
	# alone (the login, an admin account's credentials, or for cgit an admin's session). Pushes
	# up to 64 MB.
	# Pushes go through git-http-guard.py: Caddy streams the body, and a push it cuts off at
	# max_size would otherwise leave git waiting forever (the guard says why).
	redir /git /git/ permanent
	redir /git-private /git-private/ permanent
	# Debian's highlight.js, for cgit's code view (web/cgit-hub.js).
	handle_path /git-hl/* {
		root * /usr/share/javascript/highlight.js
		encode gzip
		header Cache-Control "public, max-age=86400"
		header X-Content-Type-Options nosniff
		file_server
	}
	handle_path /git-static/* {
		root * /usr/share/cgit
		header X-Content-Type-Options nosniff
		file_server
	}
	handle_path /git/* {
		@smart path_regexp smart ^/([^/]+\.git/(HEAD|info/refs|objects/.+|git-upload-pack|git-receive-pack))$
		handle @smart {
			# Only the 404 of the git app's switch: the hub weighs users and private itself.
			import {$HUB_ACCESS_DIR:/etc/caddy/irate-box-access}/git-off.caddy*
			route {
				request_header -X-Irate-Session
				request_header -X-Irate-User
				forward_auth 127.0.0.1:8000 {
					uri /internal/git-access?soft=1
					header_up X-Original-URI {http.request.orig_uri}
					header_up X-Original-Method {http.request.method}
					copy_headers X-Irate-Session X-Irate-User
				}
				@irate_box_basic not header X-Irate-Session ok
				basic_auth @irate_box_basic {
					admin $2a$14$REPLACE_ME_WITH_CADDY_HASH_PASSWORD_OUTPUT
				}
			}
			request_body {
				max_size 64MB
			}
			reverse_proxy unix//run/irate-box-git.sock {
				transport fastcgi {
					env SCRIPT_FILENAME {$HUB_CODE_DIR:/opt/irate-box}/scripts/git-http-guard.py
					env GIT_PROJECT_ROOT {$HUB_GIT_ROOT:/var/lib/hub/git}/public
					env GIT_HTTP_EXPORT_ALL 1
					env PATH_INFO /{re.smart.1}
					env REMOTE_USER {http.auth.user.id}{http.request.header.X-Irate-User}
					read_timeout 1h
				}
			}
		}
		handle {
			import {$HUB_ACCESS_DIR:/etc/caddy/irate-box-access}/git.caddy*
			# As on nginx: scripts only the box's own; a README's HTML is already text.
			header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'self'"
			header X-Content-Type-Options nosniff
			reverse_proxy unix//run/irate-box-git.sock {
				header_up Cookie "irate_session=[^;]*;?\s*" ""
				transport fastcgi {
					env SCRIPT_FILENAME /usr/lib/cgit/cgit.cgi
					env CGIT_CONFIG {$HUB_GIT_ROOT:/var/lib/hub/git}/cgitrc-public
					env PATH_INFO {path}
				}
			}
		}
	}
	handle_path /git-private/* {
		# Each check in a route of its own: route is ordered after handle and forward_auth after
		# basic_auth, so written order needs one. Git's own paths
		# ask the hub about the request's credentials and otherwise answer 401, as git needs to send
		# them at all (it asks anonymously first); cgit's pages take an admin's session as well.
		@smart path_regexp smart ^/([^/]+\.git/(HEAD|info/refs|objects/.+|git-upload-pack|git-receive-pack))$
		handle @smart {
			route {
				request_header -X-Irate-Session
				request_header -X-Irate-User
				forward_auth 127.0.0.1:8000 {
					uri /internal/git-access?soft=1
					header_up X-Original-URI {http.request.orig_uri}
					header_up X-Original-Method {http.request.method}
					copy_headers X-Irate-Session X-Irate-User
				}
				@irate_box_basic not header X-Irate-Session ok
				basic_auth @irate_box_basic {
					admin $2a$14$REPLACE_ME_WITH_CADDY_HASH_PASSWORD_OUTPUT
				}
			}
			request_body {
				max_size 64MB
			}
			reverse_proxy unix//run/irate-box-git.sock {
				transport fastcgi {
					env SCRIPT_FILENAME {$HUB_CODE_DIR:/opt/irate-box}/scripts/git-http-guard.py
					env GIT_PROJECT_ROOT {$HUB_GIT_ROOT:/var/lib/hub/git}/private
					env GIT_HTTP_EXPORT_ALL 1
					env PATH_INFO /{re.smart.1}
					env REMOTE_USER {http.auth.user.id}{http.request.header.X-Irate-User}
					read_timeout 1h
				}
			}
		}
		handle {
			route {
				request_header -X-Irate-Session
				import {$HUB_ACCESS_DIR:/etc/caddy/irate-box-access}/admin-gate.caddy*
				@irate_box_basic not header X-Irate-Session admin
				basic_auth @irate_box_basic {
					admin $2a$14$REPLACE_ME_WITH_CADDY_HASH_PASSWORD_OUTPUT
				}
				request_header -X-Irate-Session
			}
			# As on nginx: scripts only the box's own; a README's HTML is already text.
			header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'self'"
			header X-Content-Type-Options nosniff
			reverse_proxy unix//run/irate-box-git.sock {
				header_up Cookie "irate_session=[^;]*;?\s*" ""
				transport fastcgi {
					env SCRIPT_FILENAME /usr/lib/cgit/cgit.cgi
					env CGIT_CONFIG {$HUB_GIT_ROOT:/var/lib/hub/git}/cgitrc-private
					env PATH_INFO {path}
				}
			}
		}
	}


	# --- /admin → the hub's own operator options ------------------------------------
	# Same credential gate as /term, and for the same reason: these change what every
	# guest sees. The hub does no auth of its own, so running it bare (no Caddy) leaves
	# /admin/settings as open as every other hub API -- fine in dev, never on the box.
	# Replace the hash:  caddy hash-password --plaintext …
	# First use: until the owner chooses a password, install.sh leaves irate-box-unclaimed
	# beside this file, and /admin is let through with no login -- where the hub serves only
	# the set-the-password page and refuses everything else. hub_control.py deletes the file
	# when the password is set; from then on the login applies. Root-owned, so the hub
	# cannot bring it back.
	handle /admin/* {
		# "Admin over HTTPS only" (root/tls.py): plain requests sent to
		# the HTTPS twin, before any login. Present only while that switch is on.
		import {$HUB_TLS_FRONT:/etc/hub/tls/front}/caddy-admin*.caddy
		@unclaimed file {
			root {$HUB_CADDY_DIR:/etc/caddy}
			try_files /irate-box-unclaimed
		}
		handle @unclaimed {
			reverse_proxy 127.0.0.1:8000 {
				# The hub's proof this came through here (server.py FRONT_SECRET), read
				# from the environment at request time, so never in Caddy's saved config.
				header_up X-Irate-Front {env.HUB_FRONT_SECRET}
			}
		}
		handle {
			# The login, or an admin account's session (access.py caddy_admin_gate): the hub's answer,
			# copied onto the request, skips the login. A guest's own X-Irate-Session never counts.
			route {
				request_header -X-Irate-Session
				import {$HUB_ACCESS_DIR:/etc/caddy/irate-box-access}/admin-gate.caddy*
				@irate_box_basic not header X-Irate-Session admin
				basic_auth @irate_box_basic {
					admin $2a$14$REPLACE_ME_WITH_CADDY_HASH_PASSWORD_OUTPUT
				}
				request_header -X-Irate-Session
			}
			reverse_proxy 127.0.0.1:8000 {
				# The hub's proof this came through here (server.py FRONT_SECRET), read
				# from the environment at request time, so never in Caddy's saved config.
				header_up X-Irate-Front {env.HUB_FRONT_SECRET}
			}
		}
	}
	redir /admin /admin/ permanent

	# --- /term → ttyd (the escape hatch) -------------------------------------------
	# Shipped disabled: unit off ⇒ this returns 502 and the card is not rendered.
	# Gated here only: ttyd has no credential, and listens on a socket only Caddy's
	# group can open, so a stray unit start is not an open root shell. Replace the hash:
	# caddy hash-password. Path passes through: ttyd runs with --base-path /term.
	handle /term/* {
		import {$HUB_ACCESS_DIR:/etc/caddy/irate-box-access}/term-off.caddy*
		# The login, or an admin account's session (access.py caddy_admin_gate): the hub's answer,
		# copied onto the request, skips the login. A guest's own X-Irate-Session never counts.
		route {
			request_header -X-Irate-Session
			import {$HUB_ACCESS_DIR:/etc/caddy/irate-box-access}/admin-gate.caddy*
			@irate_box_basic not header X-Irate-Session admin
			basic_auth @irate_box_basic {
				admin $2a$14$REPLACE_ME_WITH_CADDY_HASH_PASSWORD_OUTPUT
			}
			request_header -X-Irate-Session
		}
		reverse_proxy unix//run/ttyd/ttyd.sock
	}
	redir /term /term/ permanent

	# Nothing here sets Strict-Transport-Security. Keep it that way.
	# stderr: journald under systemd, the terminal in dev. No files to rotate.
	log {
		output stderr
		level WARN
	}
}

:80 {
	import irate_box_hub
}

# --- the add-on origin: the local add-ons ---------------------------------------------
# Their own origin, a second port, so nothing they serve can reach /admin with the owner's
# login, read the hub's storage, or script its pages. Their files are the hub user's
# ($HUB_STATE_DIR/addons/<id>/, from the librarian, no root); nothing here runs anything or
# proxies anywhere. The routes, one per add-on that is not off with its login and
# Content-Security-Policy, are the root helper's (addons-routes.caddy). Caddy follows links,
# unlike nginx's disable_symlinks: the security doctor looks for any in the folder.
(irate_box_addons) {
	root * {$HUB_ADDONS_ROOT:/var/lib/hub/addons}
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Cache-Control "no-cache"
		-Server
	}
	import {$HUB_ACCESS_DIR:/etc/caddy/irate-box-access}/addons-routes.caddy*
}

:{$HUB_ADDON_PORT:8090} {
	import irate_box_addons
}

# HTTPS: https://:443 and the add-ons' twin, each importing the same
# snippet as its plain site, with the box's certificate. Written by root/tls.py only while HTTPS
# is on; with none, this matches nothing and the box serves plain HTTP only.
import {$HUB_TLS_FRONT:/etc/hub/tls/front}/caddy-site-*.caddy
