# The Lyra's U-Boot: a redundant environment in the bootstate partition, with boot counting for RAUC.
# The partition is chosen by the device tree's /config u-boot,mmc-env-partition = "irate-bootstate",
# not by CONFIG_SYS_MMC_ENV_PART (which selects an eMMC hardware boot partition an SD card has not).
CONFIG_ENV_IS_NOWHERE=n
CONFIG_ENV_IS_IN_MMC=y
CONFIG_ENV_MMC_USE_DT=y
CONFIG_SYS_MMC_ENV_DEV=0
CONFIG_SYS_REDUNDAND_ENVIRONMENT=y
# No absolute fallback: the device tree names irate-bootstate and build-uboot.sh refuses a DTB without it. A card
# without that partition therefore has no environment to save into, rather than a write at 0 or over a root
# filesystem. This fragment is for the U-Boot route's raw bootstate, not the tryboot route's FAT one.
CONFIG_ENV_SIZE=0x2000
CONFIG_CMD_SAVEENV=y
CONFIG_BOOTCOUNT_LIMIT=y
CONFIG_BOOTCOUNT_ENV=y
CONFIG_BOOTCOUNT_BOOTLIMIT=3
CONFIG_CMD_SETEXPR=y
