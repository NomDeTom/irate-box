        "/cgit-hub.css",
        "/cgit-hub.js",
        "/draw",
        "/draw/",
        "/draw/assets/",
        "/drop.html",
        "/flasher",
        "/flasher/",
        "/flasher/THIRD-PARTY-NOTICES.txt",
        "/flasher/api/",
        "/flasher/esp-web-tools/",
        "/flasher/firmware/",
        "/flasher/flasher.html",
        "/flasher/freeocd/",
        "/git",
        "/git-hl/",
        "/git-private",
        "/git-static/",
        "/hub",
        "/hub-return.js",
        "/index.html",
        "/mermaid",
        "/mermaid/",
        "/mermaid/_app/immutable/",
        "/mqtt",
        "/notebook",
        "/notebook/",
        "/notes",
        "/notes/",
        "/palette.css",
        "/serial",
        "/serial/",
        "/serial/assets/",
        "/serial/serial-terminal.html",
        "/socket.io/",
        "/sync",
        "/sync/",
        "/term",
        "/term/",
        "/themes.html",
        "/themes.js",
        "/themes/",
        "/tools",
        "/tools/",
        "/wiki",
        "/wiki/",
        "/wiki/content/",
        "@irate_box_hub",
        "@irate_box_hub_origin",
        "@irate_box_login",
        "@irate_box_notebook_wait",
        "\\.html$",
        "^/(?<irate_box_addon>[a-z0-9-]+)/",
        "^/addons/([a-z0-9-]+/.*)$",
        "^/api/saves/[^/]+/thumb$",
        "^/git(-private)?/[^/]+\\.git/(HEAD|info/refs|objects/.+|git-upload-pack|git-receive-pack)$",
        "^/git(/.*)$",
        "^/git(?<irate_box_cgit_path>/.*)$",
        "^/git-private(/.*)$",
        "^/git-private(?<irate_box_cgit_path>/.*)$",
        "^/git-private/(?<irate_box_git_path>[^/]+\\.git/(HEAD|info/refs|objects/.+|git-upload-pack|git-receive-pack))$",
        "^/git/(?<irate_box_git_path>[^/]+\\.git/(HEAD|info/refs|objects/.+|git-upload-pack|git-receive-pack))$",
        "^/notebook/\\.(shell|proxy|runtime)",
        "^/notes/\\.(shell|proxy|runtime)"
      ],
      "roots": [
        "/usr/share/javascript/highlight.js/",
        "@ADDONS@",
        "@APPS@/draw/",
        "@APPS@/esp-web-tools/",
        "@APPS@/flasher/THIRD-PARTY-NOTICES.txt",
        "@APPS@/flasher/public/",
        "@APPS@/freeocd/",
        "@APPS@/mermaid/",
        "@APPS@/serial/",
        "@APPS@/tools/",
        "@FIRMWARE@/",
        "@STATIC@"
      ]
    }
