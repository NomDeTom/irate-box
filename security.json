  "units": {
    "caddy.service.d/irate-box.conf": {
      "User": "root",
      "source": "install.sh"
    },
    "excalidraw-room.service": {
      "CapabilityBoundingSet": [],
      "DynamicUser": "yes",
      "NoNewPrivileges": "yes",
      "PrivateDevices": "yes",
      "PrivateTmp": "yes",
      "ProtectHome": "yes",
      "ProtectProc": "invisible",
      "ProtectSystem": "strict",
      "RestrictAddressFamilies": [
        "AF_UNIX",
        "AF_INET",
        "AF_INET6",
        "AF_NETLINK"
      ],
      "source": "install.sh"
    },
    "irate-box-ap-dns.service": {
      "NoNewPrivileges": "yes",
      "PrivateTmp": "yes",
      "ProtectHome": "yes",
      "ProtectProc": "invisible",
      "ProtectSystem": "strict",
      "ReadWritePaths": [
        "-/var/lib/misc"
      ],
      "User": "root",
      "source": "code"
    },
    "irate-box-ap-hostapd.service": {
      "NoNewPrivileges": "yes",
      "PrivateTmp": "yes",
      "ProtectHome": "yes",
      "ProtectProc": "invisible",
      "ProtectSystem": "strict",
      "ReadWritePaths": [
        "-/run/hostapd"
      ],
      "User": "root",
      "source": "code"
    },
    "irate-box-ap.service": {
      "NoNewPrivileges": "yes",
      "PrivateTmp": "yes",
      "ProtectHome": "yes",
      "ProtectProc": "invisible",
      "ProtectSystem": "strict",
      "ReadWritePaths": [
        "/etc/hub",
        "/var/lib/hub",
        "-/etc/NetworkManager",
        "/etc/systemd/system",
        "/etc/sysctl.d"
      ],
      "User": "root",
      "source": "code"
    },
    "irate-box-bootkey.service": {
      "NoNewPrivileges": "yes",
      "PrivateTmp": "yes",
      "ProtectSystem": "strict",
      "ReadOnlyPaths": [
        "/sys"
      ],
      "User": "root",
      "source": "code"
    },
    "irate-box-boxdoctor.service": {
      "NoNewPrivileges": "yes",
      "PrivateTmp": "yes",
      "ProtectHome": "read-only",
      "ProtectProc": "invisible",
      "ProtectSystem": "strict",
      "ReadWritePaths": [
        "/var/lib/hub/control",
        "/var/lib/irate-box-root"
      ],
      "User": "root",
      "source": "code"
    },
    "irate-box-boxdoctor.timer": {
      "User": "root",
      "source": "code"
    },
    "irate-box-canary.service": {
      "NoNewPrivileges": "yes",
      "PrivateTmp": "yes",
      "ProtectHome": "yes",
      "ProtectProc": "invisible",
