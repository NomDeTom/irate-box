  "secrets": {
    "/etc/NetworkManager/system-connections/*": {
      "group": "root",
      "mode": "600",
      "owner": "root",
      "readers": [
        "root"
      ]
    },
    "/etc/hub/admin-password": {
      "group": "root",
      "mode": "600",
      "owner": "root",
      "readers": [
        "root"
      ]
    },
    "/etc/hub/front-secret.env": {
      "group": "root",
      "mode": "600",
      "owner": "root",
      "readers": [
        "root"
      ]
    },
    "/etc/hub/tls/ca/ca.key": {
      "group": "root",
      "mode": "600",
      "owner": "root",
      "readers": [
        "root"
      ]
    },
    "/etc/hub/tls/server.key": {
      "group": "the web server's group",
      "mode": "640",
      "owner": "root",
      "readers": [
        "root",
        "the web server's group"
      ]
    },
    "/etc/hub/update-signing.json": {
      "group": "root",
      "mode": "600",
      "owner": "root",
      "readers": [
        "root"
      ]
    },
    "/etc/nginx/irate-box.htpasswd": {
      "group": "the web server's group",
      "mode": "640",
      "owner": "root",
      "readers": [
        "root",
        "the web server's group"
      ]
    },
    "/var/lib/hub/accounts.json": {
      "group": "hub",
      "mode": "600",
      "owner": "hub",
      "readers": [
        "hub"
      ]
    },
    "/var/lib/hub/hotspot.json": {
      "group": "hub",
      "mode": "600",
      "owner": "hub",
      "readers": [
        "hub"
      ]
    },
    "/var/lib/irate-box-root/retain-key": {
      "group": "root",
      "mode": "600",
      "owner": "root",
      "readers": [
        "root"
      ]
    }
  },
